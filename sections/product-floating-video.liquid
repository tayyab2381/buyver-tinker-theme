{% liquid
  assign target_product_handle = 'buyvur-backrest-multi-comfort-intimacy-cushion'
  assign product_video = product.metafields.custom.product_video.value
  if product_video == blank
    assign product_video = section.settings.video
  endif
  assign video_poster = blank

  if product_video != blank and product_video.preview_image != blank
    assign video_poster = product_video.preview_image | image_url: width: 800
  endif
%}

{% if product.handle == target_product_handle and product_video != blank %}
  <aside
    class="product-floating-video"
    data-product-floating-video
    aria-label="Product video"
  >
    {{
      product_video
      | video_tag:
        poster: video_poster,
        autoplay: true,
        muted: true,
        loop: true,
        controls: false,
        playsinline: true,
        preload: 'metadata',
        class: 'product-floating-video__media'
    }}

    <button
      class="product-floating-video__close"
      type="button"
      data-product-floating-video-close
      aria-label="Close product video"
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </aside>

  <script>
    (() => {
      const floatingVideo = document.querySelector('[data-product-floating-video]');
      if (!floatingVideo || floatingVideo.dataset.initialized === 'true') return;

      floatingVideo.dataset.initialized = 'true';
      floatingVideo.querySelector('[data-product-floating-video-close]')?.addEventListener('click', () => {
        floatingVideo.remove();
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .product-floating-video {
    position: fixed;
    z-index: calc(var(--layer-sticky, 30) + 2);
    left: 24px;
    bottom: 24px;
    width: min(260px, calc(100vw - 48px));
    aspect-ratio: 9 / 16;
    overflow: hidden;
    isolation: isolate;
    border-radius: 16px;
    background: #111;
    box-shadow: 0 12px 32px rgb(0 0 0 / 24%);
  }

  .product-floating-video__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-floating-video__close {
    position: absolute;
    z-index: 1;
    top: 8px;
    right: 8px;
    display: grid;
    width: 28px;
    height: 28px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #111;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 2px 8px rgb(0 0 0 / 18%);
    cursor: pointer;
    font-size: 21px;
    line-height: 1;
  }

  .product-floating-video__close:hover {
    background: #fff;
  }

  .product-floating-video__close:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .product-floating-video {
      left: 12px;
      bottom: 12px;
      width: min(150px, calc(100vw - 24px));
      border-radius: 12px;
    }

    .product-floating-video__close {
      top: 6px;
      right: 6px;
      width: 25px;
      height: 25px;
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product floating video",
  "tag": "section",
  "class": "product-floating-video-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    }
  ],
  "presets": [
    {
      "name": "Product floating video"
    }
  ]
}
{% endschema %}
